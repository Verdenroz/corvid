# All values come from server.env, rendered from config.yaml. TLS-ALPN cannot be used off 443,
# so certificates come from the http-01 challenge on port 80. CORVID_MTA_STS_SITE is empty
# unless the web tier holds 443, the only port senders fetch an MTA-STS policy from.
{$CORVID_WEB_HOSTNAME}:{$CORVID_WEB_PORT} {$CORVID_MTA_STS_SITE} {
	@mta_sts host mta-sts.{$CORVID_MAIL_DOMAIN}
	handle @mta_sts {
		rewrite * /.well-known/mta-sts.txt
		reverse_proxy 127.0.0.1:8080
	}
	handle /i/* {
		reverse_proxy 127.0.0.1:8081
	}
	handle /.well-known/corvid {
		header Content-Type application/json
		respond `{"version":1,"server":"https://{$CORVID_WEB_HOSTNAME}:{$CORVID_WEB_PORT}","issuer":"https://{$CORVID_IDP_HOSTNAME}:{$CORVID_WEB_PORT}"}` 200
	}
	# The stream token and the public VAPID key need no session, so a locked phone can read them.
	@push path /corvid/push/vapid /corvid/push/stream
	handle @push {
		reverse_proxy 127.0.0.1:11333 {
			flush_interval -1
		}
	}
	# Stalwart answers a credential-less /jmap/session with 200, which forward_auth would pass.
	@corvid {
		path /corvid/update /corvid/notices /corvid/devices/*
		header Authorization *
	}
	handle @corvid {
		forward_auth 127.0.0.1:8080 {
			uri /jmap/session
		}
		reverse_proxy 127.0.0.1:11333
	}
	@corvidapp {
		path /corvid/app/*
		header Authorization *
	}
	handle @corvidapp {
		forward_auth 127.0.0.1:8080 {
			uri /jmap/session
		}
		uri strip_prefix /corvid/app
		root * /srv/corvid-apps/current
		file_server
	}
	handle {
		reverse_proxy 127.0.0.1:8080
	}
}

# Pocket-ID refuses an APP_URL with a path, so it gets its own site on the same port. Its setup
# page hands the admin account to the first visitor, and its device login lets any signed-in
# session approve a new device as itself; deploy.sh provisions users through the API.
{$CORVID_IDP_HOSTNAME}:{$CORVID_WEB_PORT} {
	@closed path /setup /setup/* /api/signup/setup /api/signup/setup/* /login/alternative/device /login/alternative/device/* /api/device-login/*
	respond @closed 404
	reverse_proxy 127.0.0.1:1411
}
