[Unit]
Description=Corvid web front end
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=corvid-caddy
Image=docker.io/library/caddy:2.10-alpine
Pod=corvid.pod
EnvironmentFile=/opt/corvid/server.env
Volume=/opt/corvid/Caddyfile:/etc/caddy/Caddyfile:ro
Volume=/opt/corvid/caddy:/data
Volume=/opt/corvid/apps:/srv/corvid-apps:ro

[Service]
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
