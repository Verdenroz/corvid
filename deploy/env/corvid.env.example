# /opt/corvid/corvid.env: Stalwart credentials for the deploy scripts. Everything else they
# need comes from the server section of config.yaml.
STALWART_URL=http://127.0.0.1:8080
# Filled in by bootstrap-server.sh on first boot. Leave empty for a new server.
STALWART_USER=
STALWART_PASSWORD=
# An admin API key, written by deploy.sh once the password works. The scripts use it ahead of
# the password, which stops working when passkeys take over sign-in.
STALWART_TOKEN=
# Generated by bootstrap.sh.
RECOVERY_ADMIN_USER=recovery
RECOVERY_ADMIN_PASSWORD=
