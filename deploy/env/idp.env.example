# /opt/corvid/idp.env: Pocket-ID's secrets. APP_URL comes from server.env, rendered from
# config.yaml, so it always matches the OIDC issuer; do not set it here.
# openssl rand -base64 32. Encrypts Pocket-ID's stored keys; there is no default.
ENCRYPTION_KEY=
# openssl rand -hex 32. Authenticates deploy/idp.sh to Pocket-ID's API as an admin; at least 16 characters.
STATIC_API_KEY=
