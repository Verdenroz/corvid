# /opt/corvid/sentinel-webhook.env: the HMAC key shared by the sentinel and Stalwart's own
# WebHook, which signs with it via an EnvironmentVariable reference in the plan. Read by both
# corvid-mail.container and corvid-sentinel.container; nothing else needs it.
# openssl rand -hex 32. Changing it invalidates every webhook Stalwart has queued.
CORVID_SENTINEL_SECRET=
