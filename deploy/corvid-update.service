[Unit]
Description=Update Corvid to the release its image tag points at
Documentation=https://verdenroz.github.io/corvid/updates/
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/corvid/deploy/update.sh
# deploy.sh waits for Stalwart's queue and verify.sh waits out restart delays.
TimeoutStartSec=1h
