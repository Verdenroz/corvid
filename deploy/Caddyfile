# All values come from server.env, rendered from config.yaml. TLS-ALPN cannot be used off 443,
# so certificates come from the http-01 challenge on port 80. CORVID_MTA_STS_SITE is empty
# unless the web tier holds 443, the only port senders fetch an MTA-STS policy from. The same
# goes for CORVID_ASSETLINKS_SITE, the mail domain's own name when Caddy serves its app links.
{$CORVID_WEB_HOSTNAME}:{$CORVID_WEB_PORT} {$CORVID_MTA_STS_SITE} {$CORVID_ASSETLINKS_SITE} {
	@mta_sts host mta-sts.{$CORVID_MAIL_DOMAIN}
	handle @mta_sts {
		rewrite * /.well-known/mta-sts.txt
		reverse_proxy 127.0.0.1:8080
	}
	@assetlinks {
		host {$CORVID_ASSETLINKS_HOST:assetlinks.invalid}
		path /.well-known/assetlinks.json
	}
	handle @assetlinks {
		header Content-Type application/json
		respond `{$CORVID_ASSETLINKS}` 200
	}
	handle /i/* {
		reverse_proxy 127.0.0.1:8081
	}
	handle /.well-known/corvid {
		header Content-Type application/json
		respond `{"version":2,"server":"https://{$CORVID_WEB_HOSTNAME}:{$CORVID_WEB_PORT}"}` 200
	}
	# The stream token and the public VAPID key need no session, so a locked phone can read them.
	@push path /corvid/push/vapid /corvid/push/stream
	handle @push {
		reverse_proxy 127.0.0.1:11333 {
			flush_interval -1
		}
	}
	# Signing in and enrolling happen before a session exists. The issuer's discovery, key set and
	# userinfo are not routed at all: Stalwart reads them on loopback.
	@auth path /corvid/auth/register/options /corvid/auth/register/finish /corvid/auth/login/options /corvid/auth/login/finish /corvid/auth/token
	handle @auth {
		reverse_proxy 127.0.0.1:11333
	}
	# Stalwart answers a credential-less /jmap/session with 200, which forward_auth would pass.
	@corvid {
		path /corvid/update /corvid/notices /corvid/devices/* /corvid/auth/passkeys /corvid/auth/passkeys/* /corvid/auth/enroll-codes
		header Authorization *
	}
	handle @corvid {
		forward_auth 127.0.0.1:8080 {
			uri /jmap/session
		}
		reverse_proxy 127.0.0.1:11333
	}
	@corvidapp {
		path /corvid/app/*
		header Authorization *
	}
	handle @corvidapp {
		forward_auth 127.0.0.1:8080 {
			uri /jmap/session
		}
		uri strip_prefix /corvid/app
		root * /srv/corvid-apps/current
		file_server
	}
	handle {
		reverse_proxy 127.0.0.1:8080
	}
}
