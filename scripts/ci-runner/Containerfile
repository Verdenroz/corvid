ARG RUNNER_VERSION=2.338.0
FROM ghcr.io/actions/actions-runner:${RUNNER_VERSION}
ARG HOST_UID=1000
ARG HOST_GID=1000
USER root
# The base image's `ubuntu` user holds uid and gid 1000; the runner takes the host user's ids so
# the bind-mounted work directory stays writable on both sides.
RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential ca-certificates dnsutils expect gettext-base git iproute2 openssl shellcheck xz-utils \
    libasound2t64 libfontconfig1 libfreetype6 libgl1 libx11-6 libxcursor1 libxext6 libxi6 libxinerama1 libxrandr2 libxrender1 libxtst6 \
 && rm -rf /var/lib/apt/lists/* \
 && userdel -r ubuntu \
 && groupmod -g "$HOST_GID" runner \
 && usermod -u "$HOST_UID" -g "$HOST_GID" runner \
 && chown -R "$HOST_UID:$HOST_GID" /home/runner
COPY --chmod=755 entrypoint.sh /usr/local/bin/entrypoint.sh
USER runner
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
